			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(MZNAG_SalesTable, InventLocationId):
                InventLocation inventLocation = InventLocation::find(this.InventLocationId);
                this.InventSiteId = inventLocation.InventSiteId;
                break;

            case fieldNum(MZNAG_SalesTable, CustAccount):
                CustTable custTable = CustTable::find(this.CustAccount);
                this.CustName = custTable.name();
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static MZNAG_SalesTable find(MZNAGSalesId _salesId)
    {
        MZNAG_SalesTable salesTable;

        select firstonly salesTable
            where salesTable.SalesId == _salesId;

        return salesTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super();
        this.SalesStatus = SalesStatus::Backorder;
        this.OrderDate   = systemDateGet();
    }

]]></Source>
