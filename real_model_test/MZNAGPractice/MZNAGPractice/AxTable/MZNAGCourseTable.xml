		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static MZNAGCourseTable find(MZNAGCRSID _courseId, boolean _forUpdate = false)
    {
        MZNAGCourseTable courseTable;

        if (_courseId)
        {
            if (_forUpdate)
            {
                courseTable.selectForUpdate(_forUpdate);
            }

            select firstonly courseTable
            where courseTable.CourseId == _courseId;
        }

        return courseTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    public static boolean exists(MZNAGCRSID _courseId)
    {
        return (select firstonly RecId from MZNAGCourseTable
                    where MZNAGCourseTable.CourseId == _courseId).RecId != 0;
    }

]]></Source>
			</Method>
