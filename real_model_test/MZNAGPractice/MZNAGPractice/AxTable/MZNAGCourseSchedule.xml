		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static MZNAGCourseSchedule find(MZNAGScheduleId _scheduleId, boolean _forUpdate = false)
    {
        MZNAGCourseSchedule courseSchedule;
        if (_scheduleId)
        {
            if (_forUpdate)
            {
                courseSchedule.selectForUpdate(_forUpdate);
            }

            select firstonly courseSchedule
                index hint ScheduleIdx
                   where courseSchedule.MZNAGScheduleId == _scheduleId;
        }
        return courseSchedule;
    }

]]></Source>
