    public static MZNAG_WorkersTable find(MZNAG_WorkerId _workerId, boolean _forUpdate = false)
    {
        MZNAG_WorkersTable workersTable;

        if(_forUpdate)
        {
            workersTable.selectForUpdate(_forUpdate);
        }

        select * from workersTable
            where workersTable.WorkerId == _workerId;

        return workersTable;
    }

