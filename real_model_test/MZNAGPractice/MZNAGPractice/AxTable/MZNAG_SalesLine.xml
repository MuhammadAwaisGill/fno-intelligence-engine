			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(MZNAG_SalesLine, SalesQty),
                 fieldNum(MZNAG_SalesLine, SalesPrice):
                this.LineAmount = this.SalesQty * this.SalesPrice;
                break;

            case fieldNum(MZNAG_SalesLine, ItemId):
                this.ItemName = InventTable::name(this.ItemId);

                MZNAG_SalesTable salesTable = MZNAG_SalesTable::find(this.SalesId);
                this.InventSiteId     = salesTable.InventSiteId;
                this.InventLocationId = salesTable.InventLocationId;

                this.SalesQty   = 1.0;
                this.LineAmount = this.SalesQty * this.SalesPrice;
                break;
        }
    }

]]></Source>
