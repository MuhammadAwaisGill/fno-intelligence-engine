				<Name>displayRemainingQty</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethodAttribute(true)]
    public display SalesQty displayRemainingQty()
    {
        return this.SalesQty - this.PickedQty;
    }

]]></Source>
