		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static MZNAGInstructor find(MZNAGInstructorId _instructorId, boolean _forUpdate = false)
    {
        MZNAGInstructor instructor;
        if(_instructorId)
        {
            if(_forUpdate)
            {
                instructor.selectForUpdate(_forUpdate);
            }
            select firstonly instructor
                where instructor.MZNAGInstructorId == _instructorId;
        }
        return instructor;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    public static boolean exists(MZNAGInstructorId _instructorId)
    {
        return (select firstonly RecId from MZNAGInstructor
            where MZNAGInstructor.MZNAGInstructorId == _instructorId).RecId != 0;
    }

]]></Source>
			</Method>
