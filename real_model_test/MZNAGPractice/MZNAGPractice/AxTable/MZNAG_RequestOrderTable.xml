			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch(_fieldId)
        {
            case fieldNum(MZNAG_RequestOrderTable, CustAccount):
                CustTable custTable = CustTable::find(this.CustAccount);
                this.CustomerName   = custTable.name();
                this.CurrencyCode   = custTable.Currency;
                break;

            case fieldNum(MZNAG_RequestOrderTable, InventLocationId):
                InventLocation inventLocation = InventLocation::find(this.InventLocationId);
                this.InventSiteId = inventLocation.InventSiteId;
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>canSubmitToWorkflow</Name>
				<Source><![CDATA[
    public boolean canSubmitToWorkflow(str _workflowType = '')
    {
        boolean ret;
        MZNAG_RequestOrderTable table;

        ret = super(_workflowType);

        select count(RecId) from table
            where table.SalesId == this.SalesId;

        if(this.Status == MZNAG_CustomWorkflowEnum::Draft && table.RecId > 0) 
        {
            ret = true;
        }
        else
        {
            ret = false;
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateWorkflowStatus</Name>
				<Source><![CDATA[
    public static void updateWorkflowStatus(RefRecId _recId, MZNAG_CustomWorkflowEnum _status)
    {
        MZNAG_RequestOrderTable table;

        select forupdate firstonly table
            where table.RecId == _recId;

        ttsbegin;

        if (_status == MZNAG_CustomWorkflowEnum::Draft)
        {
            table.SubmissionDate = dateNull();
        }

        if(_status == MZNAG_CustomWorkflowEnum::Submitted)
        {
            table.SubmissionDate = systemDateGet();
        }

        if(_status == MZNAG_CustomWorkflowEnum::Approved || 
            _status == MZNAG_CustomWorkflowEnum::Completed)
        {
            table.ApprovedDate = systemDateGet();
            table.Status = MZNAG_CustomWorkflowEnum::Approved;
        }

        table.update();

        ttscommit;
    }

]]></Source>
			</Method>
