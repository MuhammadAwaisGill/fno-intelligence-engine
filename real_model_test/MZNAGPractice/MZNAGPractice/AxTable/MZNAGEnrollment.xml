		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static MZNAGEnrollment find(MZNAGEnrollmentId _enrollmentId, boolean _forUpdate = false)
    {
        MZNAGEnrollment enrollment;
        if(_enrollmentId)
        {
            if(_forUpdate)
            {
                enrollment.selectForUpdate(_forUpdate);
            }

            select firstonly enrollment
                where enrollment.MZNAGEnrollmentId == _enrollmentId;
        }

        return enrollment;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    public static boolean exists(MZNAGEnrollmentId _enrollmentId)
    {
        return (select firstonly RecId from MZNAGEnrollment
            where MZNAGEnrollment.MZNAGEnrollmentId == _enrollmentId).RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
