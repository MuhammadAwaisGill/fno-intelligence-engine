				<Name>populateTmpData</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static void populateTmpData(MZNAGSalesId _salesId, MZNAG_SalesOrderStatus _statusToSet)
    {
        MZNAG_SalesPickingHeaderTmp pickingTmp;
        MZNAG_SalesTable    salesTable;

        select salesTable
        where salesTable.SalesId == _salesId;
        
        pickingTmp.SalesId = salesTable.SalesId;
        pickingTmp.InventSiteId = salesTable.InventSiteId;
        pickingTmp.InventLocationId = salesTable.InventLocationId;
        pickingTmp.CustName = salesTable.CustName;
        pickingTmp.CustAccount = salesTable.CustAccount;
        pickingTmp.OrderDate = salesTable.OrderDate;
        pickingTmp.PickingListId = salesTable.PickingListId;
        pickingTmp.OrderStatus = _statusToSet;
        pickingTmp.insert();
    }

]]></Source>
