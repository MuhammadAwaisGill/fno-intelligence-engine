			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static MZNAG_EmployeeTrans find(RecId _recId, boolean _forUpdate = false)
    {
        MZNAG_EmployeeTrans employeeTrans;

        if (_forUpdate)
        {
            employeeTrans.selectForUpdate(_forUpdate);
        }

        select firstonly employeeTrans
            where employeeTrans.RecId == _recId;

        return employeeTrans;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    public static boolean exist(MZNAGEmployeeId _employeeId)
    {
        MZNAG_EmployeeTrans employeeTrans;

        select firstonly RecId from employeeTrans
            where employeeTrans.EmployeeId == _employeeId;

        return employeeTrans.RecId != 0;
    }

]]></Source>
