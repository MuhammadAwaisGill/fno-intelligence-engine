			<Method>
				<Name>find</Name>
				<Source><![CDATA[
        public static MZNAG_EmployeeTable find(MZNAGEmployeeId _employeeId, boolean _forUpdate = false)
        {
            MZNAG_EmployeeTable employeeTable;

            if (_forUpdate)
            {
                employeeTable.selectForUpdate(_forUpdate);
            }

            select firstonly employeeTable
            where employeeTable.EmployeeId == _employeeId;

            return employeeTable;
        }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
        public static boolean exist(MZNAGEmployeeId _employeeId)
        {
            MZNAG_EmployeeTable employeeTable;

            select firstonly RecId from employeeTable
            where employeeTable.EmployeeId == _employeeId;

            return employeeTable.RecId != 0;
        }

]]></Source>
