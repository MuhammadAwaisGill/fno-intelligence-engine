						<Source><![CDATA[
        public void clicked()
        {
            super();

            //MZNAG_SalesPickingListTmp tmp = element.dataSource(FormDataSourceStr(MZNAG_SalesEditLines,MZNAG_SalesPickingListTmp ));

            if(MZNAG_SalesPickingLinesTmp.validateWrite())
            {
                MZNAG_PickingListEngine::postPickingList(MZNAG_SalesPickingHeaderTmp);
            }

            FormRun callerForm;

            if (element.args() && element.args().caller())
            {
                callerForm = element.args().caller() as FormRun;
            }

            if (callerForm)
            {
                FormDataSource salesTable_ds = callerForm.dataSource(formDataSourceStr(MZNAG_DetailsTransactionForm, MZNAG_SalesTable));
                FormDataSource salesLine_ds  = callerForm.dataSource(formDataSourceStr(MZNAG_DetailsTransactionForm, MZNAG_SalesLine));

                if (salesTable_ds)
                {
                    salesTable_ds.research(true);
                }
                if (salesLine_ds)
                {
                    salesLine_ds.research(true);
                }

                callerForm.updateButtonStates();
            }

            element.close();
        }
