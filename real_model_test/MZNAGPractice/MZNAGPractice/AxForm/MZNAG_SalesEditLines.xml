						<Name>validateWrite</Name>
						<Source><![CDATA[
        public boolean validateWrite()
        {
            boolean ret;
        
            ret = super();

            if(MZNAG_SalesPickingLinesTmp.PickedQty <= 0 ||  MZNAG_SalesPickingLinesTmp.PickedQty > MZNAG_SalesPickingLinesTmp.QtyToPick)
            {
                return false;
                info("Update quantity is either 0 or negative or its greater than remaining quantity");
            }

            return true;
        
            return ret;
        }

]]></Source>
