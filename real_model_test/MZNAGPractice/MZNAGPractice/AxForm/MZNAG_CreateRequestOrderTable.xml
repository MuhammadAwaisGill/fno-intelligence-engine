								<Name>modified</Name>
								<Source><![CDATA[
            /// <summary>
            ///
            /// </summary>
            public void modified()
            {
                super();
                MZNAG_CreateRequestOrderTable createRequestOrderTableDelete;
                MZNAG_CreateRequestOrderLine createRequestOrderLineDelete;
                delete_from createRequestOrderTableDelete;
                delete_from createRequestOrderLineDelete;

                SalesTable salesTable = SalesTable::find(MZNAG_CreateRequestOrderTable.SalesId);
                SalesLine salesline;

                MZNAG_CreateRequestOrderTable.CustAccount = salesTable.CustAccount;
                MZNAG_CreateRequestOrderTable.CustomerName = salesTable.customerName();
                MZNAG_CreateRequestOrderTable.CurrencyCode = salesTable.CurrencyCode;
                MZNAG_CreateRequestOrderTable.InventSiteId = salesTable.InventSiteId;
                MZNAG_CreateRequestOrderTable.InventLocationId = salesTable.InventLocationId;
                MZNAG_CreateRequestOrderTable.insert();

                while select * from salesline
                where salesline.SalesId == salesTable.SalesId
                {
                    MZNAG_CreateRequestOrderLine.clear();
                    MZNAG_CreateRequestOrderLine.SalesId    = salesline.SalesId;
                    MZNAG_CreateRequestOrderLine.LineNum    = salesline.LineNum;
                    MZNAG_CreateRequestOrderLine.ItemId     = salesline.ItemId;
                    MZNAG_CreateRequestOrderLine.ItemName   = salesline.itemName();
                    MZNAG_CreateRequestOrderLine.SalesQty   = salesline.SalesQty;
                    MZNAG_CreateRequestOrderLine.SalesPrice = salesline.SalesPrice;
                    MZNAG_CreateRequestOrderLine.LineAmount = salesline.LineAmount;

                    MZNAG_CreateRequestOrderLine.insert();
                }
                MZNAG_CreateRequestOrderLine_ds.research(true);
            }

]]></Source>
							</Method>
