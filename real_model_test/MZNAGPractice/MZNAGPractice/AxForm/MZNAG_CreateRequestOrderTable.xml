				<Methods>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            super();
            MZNAG_CreateRequestOrderLine createRequestOrderLine;

            select maxof(LineNum) from createRequestOrderLine
                where createRequestOrderLine.SalesId == MZNAG_CreateRequestOrderLine.SalesId;

            MZNAG_CreateRequestOrderLine.LineNum = createRequestOrderLine.LineNum + 1;

            MZNAG_CreateRequestOrderLine.SalesQty = 1;
        }

]]></Source>
