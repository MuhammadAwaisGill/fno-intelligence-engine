					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();
            
            MZNAG_RequestOrderTable requestOrder;
            MZNAG_RequestOrderLine requestLine;
            MZNAG_CreateRequestOrderTable createRequestOrder = MZNAG_CreateRequestOrderTable_ds.cursor();
            MZNAG_CreateRequestOrderLine createRequestLine;

            requestOrder.SalesId       = createRequestOrder.SalesId;
            requestOrder.CustAccount   = createRequestOrder.CustAccount;
            requestOrder.CustomerName      = createRequestOrder.CustomerName;
            requestOrder.CurrencyCode  = createRequestOrder.CurrencyCode;
            requestOrder.InventSiteId  = createRequestOrder.InventSiteId;
            requestOrder.InventLocationId   = createRequestOrder.InventLocationId;
            requestOrder.SalesStatus   = createRequestOrder.SalesStatus;
            requestOrder.insert();

            while select createRequestLine
            {
                requestLine.clear();
                requestLine.SalesId       = createRequestLine.SalesId;
                requestLine.ItemId        = createRequestLine.ItemId;
                requestLine.ItemName      = createRequestLine.ItemName;
                requestLine.SalesPrice    = createRequestLine.SalesPrice;
                requestLine.SalesQty      = createRequestLine.SalesQty;
                requestLine.LineNum       = createRequestLine.LineNum;
                requestLine.insert();
             }

            FormRun callerForm;

            if (element.args() && element.args().caller())
            {
                callerForm = element.args().caller() as FormRun;
            }

            if (callerForm)
            {
                FormDataSource requestOrderTable_ds = callerForm.dataSource(formDataSourceStr(MZNAG_RequestOrderTable, MZNAG_RequestOrderTable));
                FormDataSource requestOrderLine_ds = callerForm.dataSource(formDataSourceStr(MZNAG_RequestOrderTable, MZNAG_RequestOrderLine));
             
                if (requestOrderTable_ds)
                {
                    requestOrderTable_ds.research(true);
                }
                if (requestOrderLine_ds)
                {
                    requestOrderLine_ds.research(true);
                }
            } 

            element.close();
        }

]]></Source>
