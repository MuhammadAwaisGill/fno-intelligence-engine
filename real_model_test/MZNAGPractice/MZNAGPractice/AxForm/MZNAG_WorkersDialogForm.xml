				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            if(element.args())
            {
                MZNAG_WorkersTable callerRecord = element.args().record();
                
                if(callerRecord.RecId != 0)
                {
                    this.query()
                        .dataSourceTable(tableNum(MZNAG_WorkersTable))
                        .addRange(fieldNum(MZNAG_WorkersTable,RecId))
                        .value(queryValue(callerRecord.RecId));
                }
            }

            super();
        }

]]></Source>
					</Method>
