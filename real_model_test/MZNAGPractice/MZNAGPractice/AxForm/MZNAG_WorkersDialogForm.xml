		<DataControls xmlns="">
			<Control>
				<Name>OkButtonControl</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            MZNAG_WorkersTable workersTable;
            MZNAG_WorkersTrans workersTrans;
            real adjustment = MZNAG_WorkersTable_AdjustmentAmount.realValue();

            ttsbegin;

            workersTable = MZNAG_WorkersTable::find(MZNAG_WorkersTable.WorkerId, true);
            real previousSalary = workersTable.Salary;
            workersTable.Salary += adjustment;
            workersTable.update();

            workersTrans.WorkerId = workersTable.WorkerId;
            workersTrans.WorkerName = workersTable.WorkerName;
            workersTrans.Designation = workersTable.Designation;
            workersTrans.PreviousSalary = previousSalary;
            workersTrans.NewSalary = workersTable.Salary;
            workersTrans.AdjustmentAmount = adjustment;
            workersTrans.TransDate = systemDateGet();
            workersTrans.insert();

            ttscommit;

            MZNAG_WorkersTable.reread();

            if(element.args() && element.args().caller())
            {
                FormRun callerForm = element.args().caller() as FormRun;
                if(callerForm)
                {
                    callerForm.dataSource(formDataSourceStr(MZNAG_WorkersSimpleListForm, MZNAG_WorkersTable)).research(true);
                }
            }

            element.closeOk();

        }

]]></Source>
					</Method>
				</Methods>
