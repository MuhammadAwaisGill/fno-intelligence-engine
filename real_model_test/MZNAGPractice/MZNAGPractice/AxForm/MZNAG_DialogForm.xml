		<DataControls xmlns="">
			<Control>
				<Name>OkButton</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            MZNAG_EmployeeTable      employeeTable;
            MZNAG_EmployeeTrans transTable;
            real                     adjustment = MZNAG_EmployeeTable_AdjustmentAmount.realValue();

            if (adjustment == 0)
            {
                warning("Please enter a non-zero adjustment amount.");
                return;
            }

            ttsbegin;

            employeeTable = MZNAG_EmployeeTable::find(MZNAG_EmployeeTable.EmployeeId, true);
            real previousSalary = employeeTable.Salary;
            employeeTable.Salary += adjustment;
            employeeTable.update();

            transTable.EmployeeId       = employeeTable.EmployeeId;
            transTable.EmployeeName     = employeeTable.EmployeeName;
            transTable.AdjustmentAmount = adjustment;
            transTable.PreviousSalary   = previousSalary;
            transTable.NewSalary        = employeeTable.Salary;
            transTable.TransDate = systemDateGet();            
            transTable.insert();
            ttscommit;

            if (element.args() && element.args().caller())
            {
                FormRun callerForm = element.args().caller() as FormRun;
                if (callerForm)
                {
                    callerForm.dataSource(formDataSourceStr(MZNAG_SimpleList, MZNAG_EmployeeTable)).research(true);
                }
            }

            element.closeOk();
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
			<Control>
