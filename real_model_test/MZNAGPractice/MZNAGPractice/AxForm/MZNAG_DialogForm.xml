				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            if (element.args() && element.args().dataset() == tableNum(MZNAG_EmployeeTable))
            {
                MZNAG_EmployeeTable callerRecord = element.args().record();

                if (callerRecord.RecId != 0)
                {
                    this.query()
                    .dataSourceTable(tableNum(MZNAG_EmployeeTable))
                    .addRange(fieldNum(MZNAG_EmployeeTable, RecId))
                    .value(queryValue(callerRecord.RecId));
                }
            }

            super();
        }

]]></Source>
					</Method>
				</Methods>
