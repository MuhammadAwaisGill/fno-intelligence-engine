			<Method>
				<Name>updateButtonStates</Name>
				<Source><![CDATA[
    public void updateButtonStates()
    {
        MZNAG_SalesLine          salesLine;
        MZNAG_SalesPickingHeader pickingHeader;

        boolean canGeneratePickingList = false;
        boolean hasPickingJournal      = false;
        boolean canPostPackingSlip     = false;
        boolean hasPackingJournal      = false;

        if (MZNAG_SalesTable.SalesId)
        {
            select firstonly RecId from salesLine
                where salesLine.SalesId == MZNAG_SalesTable.SalesId
                   && (salesLine.SalesQty - salesLine.PickedQty) > 0;
            canGeneratePickingList = (salesLine.RecId != 0);

            select firstonly RecId from pickingHeader
                where pickingHeader.SalesId == MZNAG_SalesTable.SalesId;
            hasPickingJournal = (pickingHeader.RecId != 0);

            select firstonly RecId from salesLine
                where salesLine.SalesId == MZNAG_SalesTable.SalesId
                   && salesLine.PickedQty > 0;
            canPostPackingSlip = (salesLine.RecId != 0);
        }

        MZNAG_PickingList.enabled(canGeneratePickingList);
        PickingListBtn.enabled(hasPickingJournal);
        MZNAG_PackingSlip.enabled(canPostPackingSlip);
        PackingSlipBtn.enabled(hasPackingJournal);
    }

]]></Source>
			</Method>
