        /// </summary>
        public void initValue()
        {
            super();

            MZNAG_SalesLine salesLine;

            str SalesId = MZNAG_SalesLine.SalesId;

            select maxof(LineNum) from salesLine
            where salesLine.SalesId == MZNAG_SalesLine.SalesId;

            MZNAG_SalesLine.LineNum = salesLine.LineNum + 1;
            MZNAG_SalesLine.SalesQty  = 1.0;
        }

