					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            super();

            MZNAG_RequestOrderLine requestOrderLine;

            select maxof(LineNum) from requestOrderLine
                where requestOrderLine.SalesId == MZNAG_RequestOrderLine.SalesId;

            MZNAG_RequestOrderLine.LineNum = requestOrderLine.LineNum + 1;

            MZNAG_RequestOrderLine.SalesQty = 1;
        }

]]></Source>
